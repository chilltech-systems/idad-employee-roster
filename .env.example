# Local fictional demo. Never expose demo mode publicly.
PORTAL_MODE=demo
## Read-only Google roster (server only; source workbook Viewer access required)
# PORTAL_ROSTER_SOURCE=google-sheets
# PORTAL_GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/private/path/roster-reader.json
PORTAL_ORIGIN=http://127.0.0.1:3210
# Isolated test MongoDB only; no existing IDAD data credentials.
# PORTAL_MODE=mongo-test
# PORTAL_MONGODB_URI=
# PORTAL_MONGODB_DATABASE=employee_directory_test
# PORTAL_ENABLE_TEST_WRITES=yes
# PORTAL_STORES_JSON=[{"id":"STORE-001","state":"Example","brand":"Example Brand","name":"Example Store","posSource":"example-pos"}]
# Dedicated ScheduleDB principal: read-only access to ScheduleDB.google_sheets.
# PORTAL_SCHEDULE_CATALOG_MONGODB_URI=
# PORTAL_ROSTER_URL=https://your-read-only-adapter.example/roster
# PORTAL_ROSTER_TOKEN=

# Private copied schedule only; do not substitute a live schedule ID.
# PORTAL_DRAFT_ID=approved-schedule-target-id
# PORTAL_CALIFORNIA_DRAFT_ID=approved-california-schedule-target-id
# PORTAL_GOOGLE_DRAFT_SERVICE_ACCOUNT_FILE=/absolute/private/path/schedule-writer.json
# Local worker runs only while its process is running; no autostart.
# PORTAL_AUTOMATION_ENABLED=yes

# Hosted: use server-only secret environment variables, never NEXT_PUBLIC_*.
# Leave PORTAL_ORIGIN unset to use Vercel's exact generated deployment URL,
# or set it to the single intended HTTPS alias origin (without a trailing slash).
# PORTAL_GOOGLE_SERVICE_ACCOUNT_JSON=
# PORTAL_GOOGLE_DRAFT_SERVICE_ACCOUNT_JSON=
# Do not enable draft writes on a fictional fixture deployment.
# CRON_SECRET=
# SHA-256 hex digest of the dedicated Data Gateway reporting token; never store the raw token here.
# PORTAL_REPORT_EXPORT_TOKEN_SHA256=
# SHA-256 hex digest of the dedicated n8n California schedule export token.
# PORTAL_CALIFORNIA_EXPORT_TOKEN_SHA256=
# PORTAL_HOSTED_SYNC_ENABLED=yes

# Production mode is intentionally IDAD-specific and guarded in code. A fork
# must review those guards before using a different database or runtime role.
# PORTAL_MODE=mongo-production
# PORTAL_ENABLE_PRODUCTION_WRITES=yes
# PORTAL_MONGODB_DATABASE=employee_directory
# PORTAL_MONGODB_URI=
# PORTAL_SCHEDULE_CATALOG_MONGODB_URI=
# PORTAL_STORES_JSON=
